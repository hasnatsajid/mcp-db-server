# Copy to .env and fill in. Never commit .env.

# Transport: stdio (Claude Desktop / Claude Code) or http
MCP_TRANSPORT=stdio
HTTP_ADDR=127.0.0.1:8090
# Required for MCP_TRANSPORT=http, at least 32 characters.
# Generate one with: openssl rand -hex 32
HTTP_AUTH_TOKEN=<your-random-token>

# Connect as a dedicated role that only has SELECT grants.
# With docker-compose: postgres://mcp_readonly:<MCP_READONLY_PASSWORD>@localhost:5432/sample?sslmode=disable
DATABASE_URL=postgres://<readonly_user>:<password>@<host>:5432/<db>?sslmode=require

# Safety limits
MAX_ROWS=500
QUERY_TIMEOUT=5s
ALLOW_SCHEMAS=public
DENY_TABLES=public.users,public.api_keys
# Empty writes audit lines to stderr. Send SIGHUP to reopen after rotation.
AUDIT_LOG_PATH=./audit.jsonl

LOG_LEVEL=info
# json (default) or text
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=5s

# docker-compose sample database
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=sample
MCP_READONLY_PASSWORD=<readonly-password>

# Integration tests: an admin URL for a disposable database (tables are created
# in a throwaway schema). Run with `make test-integration`.
# MCP_TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5432/sample?sslmode=disable
