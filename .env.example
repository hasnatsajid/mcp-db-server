# Copy to .env and fill in. Never commit .env.

# Transport: stdio (Claude Desktop / Claude Code) or http
MCP_TRANSPORT=stdio
HTTP_ADDR=127.0.0.1:8090

# Connect as a dedicated role that only has SELECT grants.
DATABASE_URL=postgres://<readonly_user>:<password>@<host>:5432/<db>?sslmode=require

# Safety limits
MAX_ROWS=500
QUERY_TIMEOUT=5s
ALLOW_SCHEMAS=public
DENY_TABLES=public.users,public.api_keys
AUDIT_LOG_PATH=./audit.jsonl

LOG_LEVEL=info
SHUTDOWN_TIMEOUT=5s

# docker-compose sample database
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=sample
